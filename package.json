{
  "name": "@asafarim/changelog-timeline",
  "version": "1.1.0",
  "description": "Responsive, paginated vertical changelog timeline using ASafariM design tokens",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/style.css",
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "changelog-demo/src/public/changelog-demo.png"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "demo": "pnpm build && pnpm --filter @asafarim/changelog-timeline-demo dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm build",
    "deploy": "pnpm build && pnpm --filter @asafarim/changelog-timeline-demo deploy",
    "release": "node scripts/release.js",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@asafarim/design-tokens": "^0.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "changelog",
    "timeline",
    "react",
    "typescript",
    "asafarim"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AliSafari-IT/changelog-timeline.git"
  },
  "homepage": "https://alisafari-it.github.io/changelog-timeline/",
  "author": "Ali Safari",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  }
}
